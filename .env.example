# Django API
SECRET_KEY=change-me-in-production
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://forhire:forhire@localhost:5432/forhire
CORS_ALLOWED_ORIGINS=http://localhost:3847
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Vite SPA
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Razorpay test mode (Dashboard → Account & Settings → API Keys, Test Mode)
